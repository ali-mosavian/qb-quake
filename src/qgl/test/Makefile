# The qgl suite: one asm test per file, assembled and linked natively
# with jwasm+jwlink, each run in its own headless DOSBox.
#
#   make            run everything
#   make t01base    run one test
#
# No DOS toolchain, no BASIC, no UGLV.LIB: the tests link the qgl objects
# directly plus memstub for the allocator. That is what makes a failure
# here point at qgl rather than at the renderer around it.
TC     ?= $(HOME)/work/other/d32x/toolchains/native/bin
DOSBOX ?= $(HOME)/work/other/dosbox-x-debug/src/dosbox-x
ROOT   := $(abspath ../../..)
QGL    := $(abspath ..)
B      ?= $(ROOT)/build/qgl-test
JWASM  := $(TC)/jwasm -c -Cp -Zg -omf -I$(QGL) -I.
JWLINK := $(TC)/jwlink

# Derived, not listed: a hand-written list is a test that silently stops
# running the day someone forgets to add it, and the suite still says
# PASS. tfw.asm is the framework, not a test, so it is excluded by name.
TESTS  := $(filter-out tfw,$(basename $(wildcard t*.asm)))

# The layer under test. Every test links all of it -- these are small and
# a per-test object list would drift from reality the first time a module
# grew a dependency.
#
# QGLCORE is the surface layer proper: the boundary plus mgl's DC layer
# transcribed. sf.asm dispatches into every one of them, so they travel
# together -- naming a subset is a link that emits an EXE anyway and then
# executes an int 3 at the first row lookup.
QGLCORE := $(QGL)/sf.asm $(QGL)/mem.asm $(QGL)/gem.asm \
           $(QGL)/qglnew.asm $(QGL)/qglview.asm $(QGL)/qgldc.asm \
           $(QGL)/qglrow.asm \
           $(QGL)/dct/dctmem.asm $(QGL)/dct/dctems.asm

# file.asm FIRST, as the renderer's Makefile has it: a VFS driver
# registers by placing a row in a segment file.asm brackets. jwlink
# sorts the class by name and would not mind; MS LINK lays it out in
# the order it meets the modules, and the two builds should agree.
QGLSRC := $(QGL)/file.asm $(QGL)/vga.asm $(QGLCORE) \
          $(QGL)/txt.asm $(QGL)/dr.asm \
          $(QGL)/z.asm $(QGL)/clip.asm $(QGL)/rs.asm $(QGL)/sb.asm \
          $(QGL)/zip.asm $(QGL)/ar.asm \
          $(QGL)/log.asm $(QGL)/tmr.asm $(QGL)/kbd.asm $(QGL)/mouse.asm \
          $(QGL)/b8/b8fill.asm $(QGL)/b8/b8span.asm
# Objects are DERIVED from QGLSRC, never listed again. Hand-listing them
# meant every new module had to be added in three places, and twice a
# careless substitution folded two assembles into one and broke the link.
QGLOBJS = $(foreach s,$(QGLSRC),$(@D)/$(notdir $(s:.asm=.obj)))

EMPTY :=
SPACE := $(EMPTY) $(EMPTY)
COMMA := ,
commas = $(subst $(SPACE),$(COMMA),$(strip $(1)))

BENCH  := $(basename $(wildcard b*.asm))
# The application links this native rebuild. Do not benchmark whichever copy
# happened to be staged by the last VBDOS build.
UGLLIB ?= $(ROOT)/build/native-mgl/UGLV.LIB

# Link only the qgl modules each benchmark reaches. MGL is an archive and
# already gets demand-loaded; linking every qgl object beside it made EXE/map
# footprint comparisons structurally biased against qgl.
$(B)/b02prim/b.exe: QGLSRC := $(QGLCORE) \
                              $(QGL)/file.asm \
                              $(QGL)/dr.asm \
                              $(QGL)/b8/b8fill.asm
$(B)/b03font/b.exe: QGLSRC := $(QGLCORE) \
                              $(QGL)/txt.asm $(QGL)/file.asm \
                              $(QGL)/dr.asm \
                              $(QGL)/b8/b8fill.asm
# z.asm for the depth pair: qgl_z_new shapes from a Surface and uglNewZ
# from a DC, which are now the same struct, so one MEM DC serves both arms.
$(B)/b04mem/b.exe: QGLSRC := $(QGLCORE) \
                             $(QGL)/file.asm $(QGL)/z.asm
$(B)/b07scale/b.exe: QGLSRC := $(QGLCORE) \
                               $(QGL)/file.asm \
                               $(QGL)/dr.asm \
                               $(QGL)/b8/b8fill.asm
$(B)/b06movq/b.exe: QGLSRC := $(QGLCORE) \
                              $(QGL)/file.asm \
                              $(QGL)/dr.asm \
                              $(QGL)/b8/b8fill.asm
$(B)/b05blit/b.exe: QGLSRC := $(QGLCORE) \
                              $(QGL)/file.asm \
                              $(QGL)/dr.asm \
                              $(QGL)/b8/b8fill.asm

all: hangcheck $(TESTS:%=$(B)/%/pass)
	@echo "qgl suite: $(words $(TESTS)) tests PASS"

# The harness is part of the suite. run1.sh's timeout used to send a
# signal dosbox-x ignores, so a test that never exited hung the gate
# instead of failing -- and a gate that can hang is not a gate.
hangcheck:
	@sh hangcheck.sh

$(TESTS): %: $(B)/%/pass

# Every test directory gets the font. It was being generated by hand,
# so t04txt and t05file passed only where someone had already made one
# and a clean checkout would have failed them -- and a test that cannot
# open its fixture passes vacuously, which is worse than failing.
FONT   := font.fnt

$(B)/%/$(FONT): $(ROOT)/data/base.dat $(ROOT)/tools/mkfont.py
	@mkdir -p $(@D)
	@python3 $(ROOT)/tools/mkfont.py $< font/4x6.fnt $@ > /dev/null

# The real atlas, straight out of the project's own asset archive --
# 114688 bytes, the size the renderer actually transfers. A synthesized
# fixture of a convenient size would not have caught the wrap.
# The archive itself, for the member reader, and one member extracted by a
# real unzip so the test can diff its own read against it.
$(B)/%/assets.zip: $(ROOT)/data/assets/assets.zip
	@mkdir -p $(@D)
	@cp $< $@

$(B)/%/colmap.bin: $(ROOT)/data/assets/assets.zip
	@mkdir -p $(@D)
	@unzip -p $< colmap.bin > $@

# The same member again, in an archive written by the SYSTEM zip rather
# than by mkassets. It stores a 28-byte extra field on every local header
# where ours writes none, so the skip past that field -- dead code
# against our own archive, and the classic way to land a read 28 bytes
# into the data -- is exercised by something we did not write.
$(B)/%/sys.zip: $(B)/%/colmap.bin
	@cd $(@D) && rm -f sys.zip && zip -0 -q sys.zip colmap.bin

$(B)/%/fgeom.bin: $(ROOT)/data/assets/assets.zip
	@mkdir -p $(@D)
	@unzip -p $< fgeom.bin > $@

# t30in wants a key typed at it; run1.sh reads the file.
$(B)/t30in/pass: $(B)/t30in/keys
$(B)/t30in/keys:
	@mkdir -p $(@D)
	@echo a > $@

$(B)/%/pass: $(B)/%/t.exe $(B)/%/$(FONT) $(B)/%/fgeom.bin $(B)/%/assets.zip $(B)/%/colmap.bin $(B)/%/sys.zip run1.sh
	@sh run1.sh $(DOSBOX) $(@D)

# t21mem is the one test that needs the BASIC fallback in mem.asm, which
# only exists under __BASIC__. It brings its own B$SETM; the objects are
# per-test-directory, so nothing else sees the define.
$(B)/t21mem/t.exe: JWASM += -D__BASIC__=1

# t22log is the only test built with the logger on, so it is the only
# place the transcribed LOG lines emit anything. _DEBUG_ is mgl's own
# gate, set here rather than in qgl.inc so that header stays log.inc
# verbatim. The define reaches every object in this test's directory,
# which is deliberate: the interesting question is whether qglNew still
# works with its own LOG lines live, not whether the macros expand in
# isolation.
$(B)/t22log/t.exe: JWASM += -D_DEBUG_=1

$(B)/%/t.exe: %.asm tfw.asm tfw.inc $(QGLSRC) $(QGL)/qgl.inc
	@mkdir -p $(@D)
	@$(JWASM) -Fo$(@D)/test.obj $< > /dev/null
	@$(JWASM) -Fo$(@D)/tfw.obj tfw.asm > /dev/null
	@for s in $(QGLSRC); do \
	    $(JWASM) -Fo$(@D)/`basename $$s .asm`.obj $$s > /dev/null || exit 1; \
	done
	@$(JWLINK) option quiet format dos name $@ \
	    file $(call commas,$(@D)/test.obj $(@D)/tfw.obj $(QGLOBJS))

clean:
	rm -rf $(B)

.SECONDARY:
.PHONY: all clean hangcheck $(TESTS)

# The benchmarks link mgl as well, so the two rasterisers can be run
# against each other inside one process. Not part of `all`: they take
# minutes and they measure rather than assert.
bench: $(BENCH:%=bench-%)

bench-%: $(B)/%/b.exe $(B)/%/$(FONT) runbench.sh
	@sh runbench.sh $(DOSBOX) $(<D)

$(B)/%/b.exe: %.asm tfw.asm tfw.inc mglstub.asm $(QGLSRC) $(QGL)/qgl.inc $(UGLLIB)
	@mkdir -p $(@D)
	@$(JWASM) -Fo$(@D)/test.obj $< > /dev/null
	@$(JWASM) -Fo$(@D)/tfw.obj tfw.asm > /dev/null
	@$(JWASM) -Fo$(@D)/mglstub.obj mglstub.asm > /dev/null
	@for s in $(QGLSRC); do \
	    $(JWASM) -Fo$(@D)/`basename $$s .asm`.obj $$s > /dev/null || exit 1; \
	done
	@shasum -a 256 $(UGLLIB) > $(@D)/mgl.sha256
	@$(JWLINK) option quiet format dos name $@ option map=$(@D)/b.map \
	    file $(call commas,$(@D)/test.obj $(@D)/tfw.obj $(@D)/mglstub.obj $(QGLOBJS)) \
	    library $(UGLLIB) > $(@D)/link.out 2>&1
	@if [ -s $(@D)/link.out ]; then \
	    echo "LINKERR $(@D) -- link.out is not empty:"; \
	    cat $(@D)/link.out; rm -f $@; exit 1; \
	fi
